generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// TENANT & ORGANIZATION
// =====================================================

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  primaryColor  String   @default("#f59e0b")
  address       String?
  city          String?
  country       String?
  phone         String?
  email         String?
  subscription  String   @default("starter")
  taxId         String?
  registrationNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stations       Station[]
  users          User[]
  fleetAccounts  FleetAccount[]
  customers      Customer[]
  fuelCards      FuelCard[]
  suppliers      Supplier[]
  notifications  Notification[]
  promotions     Promotion[]
  loyaltyRules   LoyaltyRule[]
}

model Station {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  code          String
  address       String?
  city          String?
  region        String?
  country       String?
  phone         String?
  email         String?
  latitude      Float?
  longitude     Float?
  isActive      Boolean  @default(true)
  stationType   String   @default("fuel") // fuel, cng, ev, hybrid
  operatingHours String?
  timezone      String   @default("Asia/Karachi")
  currency      String   @default("PKR")
  taxRate       Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  tanks              Tank[]
  dispensers         Dispenser[]
  shifts             Shift[]
  employees          Employee[]
  priceBoards        PriceBoard[]
  deliveries         FuelDelivery[]
  retailProducts     RetailProduct[]
  lubricantProducts  LubricantProduct[]
  evChargers         EVCharger[]
  cngDispensers      CNGDispenser[]
  anprCameras        ANPRCamera[]
  rfidReaders        RFIDReader[]
  retailTransactions RetailTransaction[]
  transactions       Transaction[]
  expenses           Expense[]
  maintenanceRecords MaintenanceRecord[]
  aiAlerts           AIAlert[]
  chargingSessions   ChargingSession[]
  carWashSessions    CarWashSession[]
  environmentalAlerts EnvironmentalAlert[]
  dailyReports       DailyReport[]
  meterRecords       MeterRecord[]
  supplierInvoices   SupplierInvoice[]
  purchaseOrders     PurchaseOrder[]
  tankCalibrations   TankCalibration[]
  lotterySales       LotterySale[]
  promotions         PromotionUsage[]
  payrollRecords     PayrollRecord[]
  leaveRequests      LeaveRequest[]
  vaporRecoveryReadings VaporRecoveryReading[]
}

model User {
  id          String   @id @default(cuid())
  tenantId    String
  email       String   @unique
  name        String
  role        String   @default("viewer") // superadmin, admin, manager, operator, cashier, attendant, viewer
  avatar      String?
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs  AuditLog[]
}

// =====================================================
// FORECOURT - DISPENSERS, NOZZLES, PUMPS
// =====================================================

model Dispenser {
  id                String   @id @default(cuid())
  stationId         String
  name              String
  code              String
  manufacturer      String?  // tatsuno, gilbarco, wayne, tokheim, etc.
  model             String?
  serialNumber      String?
  controllerType    String?  // pts, fusion, doms, hectronic, etc.
  communicationType String?  // tcpip, rs232, rs485, serial, ethernet
  ipAddress         String?
  port              Int?
  pumpLane          Int      @default(1)
  status            String   @default("idle") // idle, fueling, stopped, error, locked, maintenance
  isActive          Boolean  @default(true)
  lastCommunication DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  station   Station   @relation(fields: [stationId], references: [id])
  nozzles   Nozzle[]
  fuelings   Fueling[]
}

model Nozzle {
  id              String   @id @default(cuid())
  dispenserId     String
  nozzleNumber    Int
  fuelType        String
  fuelGrade       String?
  meterReading    Float    @default(0)
  previousReading Float    @default(0)
  totalizer       Float    @default(0)
  calibrationDate DateTime?
  calibrationFactor Float  @default(1.0)
  status          String   @default("idle")
  isActive        Boolean  @default(true)
  lastCalibration DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dispenser        Dispenser         @relation(fields: [dispenserId], references: [id])
  fuelings         Fueling[]
  maintenanceRecords MaintenanceRecord[]
  meterRecords     MeterRecord[]
}

// =====================================================
// TANK & WET STOCK MANAGEMENT
// =====================================================

model Tank {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  code            String
  capacity        Float
  currentLevel    Float    @default(0)
  waterLevel      Float    @default(0)
  temperature     Float    @default(0)
  density         Float?
  fuelType        String
  atgType         String?
  atgIpAddress    String?
  atgPort         Int?
  status          String   @default("normal")
  lastReading     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station          Station           @relation(fields: [stationId], references: [id])
  deliveries       FuelDelivery[]
  tankReadings     TankReading[]
  reconciliations  Reconciliation[]
  calibrations     TankCalibration[]
}

model TankReading {
  id          String   @id @default(cuid())
  tankId      String
  level       Float
  volume      Float
  waterLevel  Float
  temperature Float
  density     Float?
  readingType String   @default("automatic")
  readingAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  tank        Tank     @relation(fields: [tankId], references: [id])
}

model FuelDelivery {
  id              String   @id @default(cuid())
  stationId       String
  tankId          String
  supplierId      String?
  supplierName    String
  tankerNumber    String?
  driverName      String?
  expectedVolume  Float
  actualVolume    Float    @default(0)
  density         Float?
  temperature     Float?
  productType     String
  status          String   @default("pending") // pending, arriving, unloading, completed, discrepancy
  deliveryDate    DateTime
  completedAt     DateTime?
  notes           String?
  variance        Float?
  invoiceNumber   String?
  costPerUnit     Float?
  totalCost       Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station          @relation(fields: [stationId], references: [id])
  tank        Tank             @relation(fields: [tankId], references: [id])
  supplier    Supplier?        @relation(fields: [supplierId], references: [id])
}

model Reconciliation {
  id                  String   @id @default(cuid())
  tankId              String
  stationId           String
  date                DateTime
  openingStock        Float
  deliveries          Float    @default(0)
  sales               Float    @default(0)
  closingStock        Float
  bookStock           Float
  actualStock         Float
  variance            Float
  variancePercentage  Float
  status              String   @default("pending") // pending, reviewed, approved
  reviewedBy          String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tank        Tank     @relation(fields: [tankId], references: [id])
}

model TankCalibration {
  id              String   @id @default(cuid())
  stationId       String
  tankId          String
  calibrationDate DateTime
  calibratedBy    String?
  certificateNumber String?
  volumeTable     String   // JSON string of height->volume mapping
  notes           String?
  createdAt       DateTime @default(now())

  station        Station   @relation(fields: [stationId], references: [id])
  tank           Tank      @relation(fields: [tankId], references: [id])
}

model MeterRecord {
  id              String   @id @default(cuid())
  stationId       String
  nozzleId        String
  shiftId         String?
  readingStart    Float
  readingEnd      Float?
  volumeDispensed Float?
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  station         Station  @relation(fields: [stationId], references: [id])
  nozzle          Nozzle   @relation(fields: [nozzleId], references: [id])
}

// =====================================================
// FUEL SALES & SHIFT MANAGEMENT
// =====================================================

model Fueling {
  id              String   @id @default(cuid())
  stationId       String
  dispenserId     String
  nozzleId        String
  shiftId         String?
  fuelType        String
  volume          Float
  pricePerUnit    Float
  totalAmount     Float
  paymentMethod   String   @default("cash")
  meterStart      Float
  meterEnd        Float
  attendantId     String?
  vehiclePlate    String?
  rfidTag         String?
  fleetAccountId  String?
  customerId      String?
  loyaltyPoints   Int      @default(0)
  status          String   @default("completed")
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  dispenser     Dispenser     @relation(fields: [dispenserId], references: [id])
  nozzle       Nozzle        @relation(fields: [nozzleId], references: [id])
  shift        Shift?        @relation(fields: [shiftId], references: [id])
  attendant    Employee?     @relation(fields: [attendantId], references: [id])
  fleetAccount FleetAccount? @relation(fields: [fleetAccountId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
}

model Shift {
  id              String   @id @default(cuid())
  stationId       String
  shiftNumber     Int
  attendantId     String?
  supervisorId    String?
  openedAt        DateTime
  closedAt        DateTime?
  openingCash     Float    @default(0)
  closingCash     Float?
  expectedCash    Float?
  cashVariance    Float?
  totalSales      Float    @default(0)
  totalVolume     Float    @default(0)
  fuelSales       Float    @default(0)
  retailSales     Float    @default(0)
  cardSales       Float    @default(0)
  fleetSales      Float    @default(0)
  creditSales     Float    @default(0)
  cashSales       Float    @default(0)
  transactionCount Int     @default(0)
  status          String   @default("open") // open, closed, reconciled
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station            Station            @relation(fields: [stationId], references: [id])
  fuelings           Fueling[]
  attendant          Employee?          @relation("ShiftAttendant", fields: [attendantId], references: [id])
  supervisor         Employee?          @relation("ShiftSupervisor", fields: [supervisorId], references: [id])
  retailTransactions RetailTransaction[]
}

// =====================================================
// FLEET & RFID
// =====================================================

model FleetAccount {
  id              String   @id @default(cuid())
  tenantId        String
  companyName     String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  creditLimit     Float    @default(0)
  currentBalance  Float    @default(0)
  dailyLimit      Float?
  monthlyLimit    Float?
  fuelTypes       String?
  status          String   @default("active")
  paymentTerms    String?  // net15, net30, cod, prepaid
  taxExempt       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  vehicles     Vehicle[]
  drivers      Driver[]
  fuelCards    FuelCard[]
  fuelings     Fueling[]
}

model Vehicle {
  id              String   @id @default(cuid())
  fleetAccountId  String
  plateNumber     String
  make            String?
  model           String?
  year            Int?
  vehicleType     String?
  rfidTag         String?
  fuelType        String?
  tankCapacity    Float?
  dailyLimit      Float?
  odometer        Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fleetAccount    FleetAccount @relation(fields: [fleetAccountId], references: [id])
}

model Driver {
  id              String   @id @default(cuid())
  fleetAccountId  String
  name            String
  licenseNumber   String?
  phone           String?
  rfidCard        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fleetAccount    FleetAccount @relation(fields: [fleetAccountId], references: [id])
}

model FuelCard {
  id              String   @id @default(cuid())
  tenantId        String
  cardNumber      String   @unique
  fleetAccountId  String?
  cardType        String   @default("fleet")
  rfidTag         String?
  pin             String?
  dailyLimit      Float?
  monthlyLimit    Float?
  balance         Float    @default(0)
  isActive        Boolean  @default(true)
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  fleetAccount FleetAccount? @relation(fields: [fleetAccountId], references: [id])
}

model RFIDReader {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  code        String
  readerType  String   @default("vehicle")
  ipAddress   String?
  port        Int?
  status      String   @default("online")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

model ANPRCamera {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  code        String
  ipAddress   String?
  port        Int?
  location    String?
  status      String   @default("online")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// PRICE MANAGEMENT
// =====================================================

model FuelPrice {
  id            String   @id @default(cuid())
  tenantId      String
  stationId     String?
  fuelType      String
  fuelGrade     String?
  pricePerUnit  Float
  previousPrice Float?
  currency      String   @default("PKR")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        String   @default("active")
  updatedBy     String?
  isGovernment  Boolean  @default(false)
  scheduledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PriceBoard {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  boardType   String   @default("led")
  ipAddress   String?
  port        Int?
  status      String   @default("online")
  isActive    Boolean  @default(true)
  lastUpdate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// RETAIL STORE & SERVICES
// =====================================================

model RetailProduct {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  sku         String?
  category    String?
  barcode     String?
  price       Float
  costPrice   Float?
  stockQty    Int      @default(0)
  minStock    Int      @default(5)
  maxStock    Int      @default(100)
  unit        String   @default("piece")
  supplierId  String?
  reorderPoint Int     @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

model RetailTransaction {
  id             String   @id @default(cuid())
  stationId      String
  shiftId        String?
  totalAmount    Float
  paymentMethod  String   @default("cash")
  items          String   // JSON string of items
  posTerminal    String?
  discountAmount Float    @default(0)
  loyaltyPointsUsed Int   @default(0)
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  station        Station  @relation(fields: [stationId], references: [id])
  shift          Shift?   @relation(fields: [shiftId], references: [id])
}

model LubricantProduct {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  brand       String?
  viscosity   String?
  category    String?
  price       Float
  costPrice   Float?
  stockQty    Int      @default(0)
  minStock    Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

model CarWashSession {
  id          String   @id @default(cuid())
  stationId   String
  shiftId     String?
  vehiclePlate String?
  washType    String   // basic, premium, deluxe
  amount      Float
  paymentMethod String @default("cash")
  status      String   @default("completed")
  startedAt   DateTime @default(now())
  completedAt DateTime?
  createdAt   DateTime @default(now())

  station     Station   @relation(fields: [stationId], references: [id])
}

model LotterySale {
  id          String   @id @default(cuid())
  stationId   String
  shiftId     String?
  gameType    String   // scratch, draw, online
  ticketCount Int      @default(1)
  saleAmount  Float
  commission  Float    @default(0)
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// SUPPLIER & PROCUREMENT
// =====================================================

model Supplier {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  code            String?
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  city            String?
  category        String   // fuel, lubricant, retail, maintenance, other
  paymentTerms    String?
  taxId           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  deliveries      FuelDelivery[]
  invoices        SupplierInvoice[]
  purchaseOrders  PurchaseOrder[]
}

model SupplierInvoice {
  id              String   @id @default(cuid())
  stationId       String
  supplierId      String
  invoiceNumber   String
  invoiceDate     DateTime
  dueDate         DateTime?
  totalAmount     Float
  taxAmount       Float    @default(0)
  netAmount       Float
  status          String   @default("pending") // pending, approved, paid, overdue, cancelled
  paidAmount      Float    @default(0)
  paidDate        DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station         Station   @relation(fields: [stationId], references: [id])
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
}

model PurchaseOrder {
  id              String   @id @default(cuid())
  stationId       String
  supplierId      String
  poNumber        String
  orderDate       DateTime
  expectedDate    DateTime?
  items           String   // JSON string of line items
  totalAmount     Float
  status          String   @default("draft") // draft, submitted, approved, received, cancelled
  approvedBy      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station         Station   @relation(fields: [stationId], references: [id])
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
}

// =====================================================
// EV & CNG
// =====================================================

model EVCharger {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  code            String
  connectorType   String   @default("type2")
  maxPowerKw      Float    @default(50)
  status          String   @default("available")
  currentSession  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station      @relation(fields: [stationId], references: [id])
  sessions    ChargingSession[]
}

model ChargingSession {
  id              String   @id @default(cuid())
  chargerId       String
  stationId       String

  station         Station  @relation(fields: [stationId], references: [id])
  vehiclePlate    String?
  energyKwh       Float    @default(0)
  durationMinutes Int      @default(0)
  pricePerKwh     Float
  totalAmount     Float    @default(0)
  paymentMethod   String   @default("cash")
  status          String   @default("active")
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  evCharger   EVCharger @relation(fields: [chargerId], references: [id])
}

model CNGDispenser {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  code            String
  pressure        Float?
  status          String   @default("idle")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// EMPLOYEE MANAGEMENT
// =====================================================

model Employee {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  employeeId      String?
  role            String   @default("attendant")
  phone           String?
  email           String?
  hireDate        DateTime?
  salary          Float?
  commissionRate  Float    @default(0)
  status          String   @default("active")
  avatar          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station        Station         @relation(fields: [stationId], references: [id])
  shifts         Shift[]              @relation("ShiftAttendant")
  supervisedShifts Shift[]              @relation("ShiftSupervisor")
  fuelings       Fueling[]
  attendance     Attendance[]
  payrollRecords PayrollRecord[]
  leaveRequests  LeaveRequest[]
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  stationId   String
  checkIn     DateTime
  checkOut    DateTime?
  status      String   @default("present") // present, absent, late, half_day
  hoursWorked Float?
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee  @relation(fields: [employeeId], references: [id])
}

model PayrollRecord {
  id              String   @id @default(cuid())
  stationId       String
  employeeId      String
  periodStart     DateTime
  periodEnd       DateTime
  baseSalary      Float
  overtimeHours   Float    @default(0)
  overtimePay     Float    @default(0)
  commissions     Float    @default(0)
  deductions      Float    @default(0)
  taxDeductions   Float    @default(0)
  netPay          Float
  status          String   @default("pending") // pending, approved, paid
  paidDate        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station         Station   @relation(fields: [stationId], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id])
}

model LeaveRequest {
  id              String   @id @default(cuid())
  stationId       String
  employeeId      String
  leaveType       String   // annual, sick, personal, unpaid
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          String   @default("pending") // pending, approved, rejected
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station         Station   @relation(fields: [stationId], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id])
}

// =====================================================
// CRM & LOYALTY
// =====================================================

model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  phone           String?
  email           String?
  loyaltyPoints   Int      @default(0)
  membershipTier  String   @default("basic")
  totalSpent      Float    @default(0)
  totalVisits     Int      @default(0)
  lastVisit       DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  fuelings     Fueling[]
}

model LoyaltyRule {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  pointsPerUnit   Float    @default(1)
  fuelType        String?  // null = all fuel types
  minimumPurchase Float?
  bonusMultiplier Float    @default(1)
  isActive        Boolean  @default(true)
  validFrom       DateTime?
  validTo         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
}

model Promotion {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  discountType    String   // percentage, fixed, bogo
  discountValue   Float
  applicableTo    String   // fuel, retail, car_wash, all
  fuelType        String?
  minimumPurchase Float?
  validFrom       DateTime
  validTo         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  usage          PromotionUsage[]
}

model PromotionUsage {
  id              String   @id @default(cuid())
  stationId       String
  promotionId     String
  customerName    String?
  discountAmount  Float
  createdAt       DateTime @default(now())

  station         Station    @relation(fields: [stationId], references: [id])
  promotion       Promotion  @relation(fields: [promotionId], references: [id])
}

// =====================================================
// FINANCE & ACCOUNTING
// =====================================================

model Transaction {
  id              String   @id @default(cuid())
  stationId       String
  tenantId        String

  station         Station  @relation(fields: [stationId], references: [id])
  type            String
  category        String
  amount          Float
  description     String?
  referenceNumber String?
  paymentMethod   String   @default("cash")
  status          String   @default("completed")
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Expense {
  id              String   @id @default(cuid())
  stationId       String

  station         Station  @relation(fields: [stationId], references: [id])
  category        String
  amount          Float
  description     String?
  vendor          String?
  receiptNumber   String?
  date            DateTime
  approvedBy      String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =====================================================
// MAINTENANCE
// =====================================================

model MaintenanceRecord {
  id              String   @id @default(cuid())
  stationId       String
  equipmentType   String
  equipmentId     String
  nozzleId        String?

  station         Station  @relation(fields: [stationId], references: [id])
  type            String
  description     String
  technician      String?
  cost            Float    @default(0)
  status          String   @default("scheduled")
  scheduledDate   DateTime
  completedDate   DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nozzle       Nozzle?   @relation(fields: [nozzleId], references: [id])
}

// =====================================================
// ENVIRONMENTAL COMPLIANCE
// =====================================================

model EnvironmentalAlert {
  id              String   @id @default(cuid())
  stationId       String
  alertType       String   // leak, spill, vapor, water_intrusion, overfill, epa_violation
  severity        String   @default("warning")
  tankId          String?
  description     String
  epaCode         String?
  isReportable    Boolean  @default(false)
  isResolved      Boolean  @default(false)
  resolvedAt      DateTime?
  reportedToAgency Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station         Station  @relation(fields: [stationId], references: [id])
}

model VaporRecoveryReading {
  id              String   @id @default(cuid())
  stationId       String
  tankId          String?
  vaporPressure   Float
  recoveryRate    Float?
  status          String   @default("normal") // normal, warning, violation
  readingAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  station         Station  @relation(fields: [stationId], references: [id])
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  stationId   String?
  title       String
  message     String
  type        String   // alert, info, warning, system, shift, delivery
  priority    String   @default("normal") // low, normal, high, urgent
  isRead      Boolean  @default(false)
  readAt      DateTime?
  actionUrl   String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

// =====================================================
// DAILY REPORTS
// =====================================================

model DailyReport {
  id              String   @id @default(cuid())
  stationId       String
  reportDate      DateTime
  totalRevenue    Float    @default(0)
  fuelRevenue     Float    @default(0)
  retailRevenue   Float    @default(0)
  totalVolume     Float    @default(0)
  transactionCount Int     @default(0)
  averageTicket   Float    @default(0)
  cashVariance    Float    @default(0)
  fuelVariance    Float    @default(0)
  expenses        Float    @default(0)
  netProfit       Float    @default(0)
  createdAt       DateTime @default(now())

  station         Station  @relation(fields: [stationId], references: [id])
}

// =====================================================
// AUDIT & SECURITY
// =====================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  tenantId    String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

// =====================================================
// AI & ANALYTICS
// =====================================================

model AIAlert {
  id          String   @id @default(cuid())
  tenantId    String
  stationId   String?

  station      Station?  @relation(fields: [stationId], references: [id])
  alertType   String
  severity    String   @default("warning")
  title       String
  description String?
  confidence  Float?
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIForecast {
  id          String   @id @default(cuid())
  tenantId    String
  stationId   String
  forecastType String
  fuelType    String?
  predictedValue Float
  confidence  Float
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
}
