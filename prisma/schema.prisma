generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// TENANT & ORGANIZATION
// =====================================================

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logo          String?
  primaryColor  String   @default("#f59e0b")
  address       String?
  city          String?
  country       String?
  phone         String?
  email         String?
  subscription  String   @default("starter")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  stations     Station[]
  users        User[]
  fleetAccounts FleetAccount[]
  customers    Customer[]
  fuelCards    FuelCard[]
}

model Station {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  address     String?
  city        String?
  region      String?
  country     String?
  phone       String?
  email       String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  stationType String   @default("fuel") // fuel, cng, ev, hybrid
  operatingHours String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  tanks        Tank[]
  dispensers   Dispenser[]
  shifts       Shift[]
  employees    Employee[]
  priceBoards  PriceBoard[]
  deliveries   FuelDelivery[]
  retailProducts RetailProduct[]
  lubricantProducts LubricantProduct[]
  evChargers   EVCharger[]
  cngDispensers CNGDispenser[]
  anprCameras ANPRCamera[]
  rfidReaders  RFIDReader[]
  retailTransactions RetailTransaction[]
  transactions Transaction[]
  expenses    Expense[]
  maintenanceRecords MaintenanceRecord[]
  aiAlerts    AIAlert[]
  chargingSessions ChargingSession[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String   @unique
  name      String
  role      String   @default("viewer") // superadmin, admin, manager, operator, viewer
  avatar    String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  auditLogs AuditLog[]
}

// =====================================================
// FORECOURT - DISPENSERS, NOZZLES, PUMPS
// =====================================================

model Dispenser {
  id                String   @id @default(cuid())
  stationId         String
  name              String
  code              String
  manufacturer      String?  // tatsuno, gilbarco, wayne, tokheim, etc.
  model             String?
  serialNumber      String?
  controllerType    String?  // pts, fusion, doms, hectronic, etc.
  communicationType String?  // tcpip, rs232, rs485, serial, ethernet
  ipAddress         String?
  port              Int?
  status            String   @default("idle") // idle, fueling, stopped, error, locked, maintenance
  isActive          Boolean  @default(true)
  lastCommunication DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  station   Station   @relation(fields: [stationId], references: [id])
  nozzles   Nozzle[]
  fuelings   Fueling[]
}

model Nozzle {
  id              String   @id @default(cuid())
  dispenserId     String
  nozzleNumber    Int
  fuelType        String   // petrol, diesel, premium, highSpeedDiesel, etc.
  fuelGrade       String?
  meterReading    Float    @default(0)
  previousReading Float    @default(0)
  totalizer       Float    @default(0)
  calibrationDate DateTime?
  calibrationFactor Float  @default(1.0)
  status          String   @default("idle") // idle, fueling, closed, error, locked, disabled
  isActive        Boolean  @default(true)
  lastCalibration DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dispenser  Dispenser @relation(fields: [dispenserId], references: [id])
  fuelings   Fueling[]
  maintenanceRecords MaintenanceRecord[]
}

// =====================================================
// TANK & WET STOCK MANAGEMENT
// =====================================================

model Tank {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  code            String
  capacity        Float    // in liters
  currentLevel    Float    @default(0)
  waterLevel      Float    @default(0)
  temperature     Float    @default(0)
  density         Float?
  fuelType        String   // petrol, diesel, premium, etc.
  atgType         String?  // veeder-root, opw, franklin, etc.
  atgIpAddress    String?
  atgPort         Int?
  status          String   @default("normal") // normal, low, critical, leak_detected, maintenance
  lastReading     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station        @relation(fields: [stationId], references: [id])
  deliveries  FuelDelivery[]
  tankReadings TankReading[]
  reconciliations Reconciliation[]
}

model TankReading {
  id          String   @id @default(cuid())
  tankId      String
  level       Float
  volume      Float
  waterLevel  Float
  temperature Float
  density     Float?
  readingType String   @default("automatic") // automatic, manual
  readingAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  tank        Tank     @relation(fields: [tankId], references: [id])
}

model FuelDelivery {
  id              String   @id @default(cuid())
  stationId       String
  tankId          String
  supplierName    String
  tankerNumber    String?
  driverName      String?
  expectedVolume  Float
  actualVolume    Float    @default(0)
  density         Float?
  temperature     Float?
  productType     String
  status          String   @default("pending") // pending, arriving, unloading, completed, discrepancy
  deliveryDate    DateTime
  completedAt     DateTime?
  notes           String?
  variance        Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
  tank        Tank      @relation(fields: [tankId], references: [id])
}

model Reconciliation {
  id                  String   @id @default(cuid())
  tankId              String
  stationId           String
  date                DateTime
  openingStock        Float
  deliveries          Float    @default(0)
  sales               Float    @default(0)
  closingStock        Float
  bookStock           Float
  actualStock         Float
  variance            Float    // actualStock - bookStock
  variancePercentage  Float
  status              String   @default("pending") // pending, reviewed, approved
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tank        Tank     @relation(fields: [tankId], references: [id])
}

// =====================================================
// FUEL SALES & SHIFT MANAGEMENT
// =====================================================

model Fueling {
  id              String   @id @default(cuid())
  stationId       String
  dispenserId     String
  nozzleId        String
  shiftId         String?
  fuelType        String
  volume          Float
  pricePerUnit    Float
  totalAmount     Float
  paymentMethod   String   @default("cash") // cash, card, fleet, credit, rfid, mobile
  meterStart      Float
  meterEnd        Float
  attendantId     String?
  vehiclePlate    String?
  rfidTag         String?
  fleetAccountId  String?
  status          String   @default("completed") // authorized, fueling, completed, cancelled, error
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  dispenser     Dispenser    @relation(fields: [dispenserId], references: [id])
  nozzle       Nozzle       @relation(fields: [nozzleId], references: [id])
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  attendant    Employee?    @relation(fields: [attendantId], references: [id])
  fleetAccount FleetAccount? @relation(fields: [fleetAccountId], references: [id])
}

model Shift {
  id              String   @id @default(cuid())
  stationId       String
  shiftNumber     Int
  attendantId     String?
  openedAt        DateTime
  closedAt        DateTime?
  openingCash     Float    @default(0)
  closingCash     Float?
  expectedCash    Float?
  cashVariance    Float?
  totalSales      Float    @default(0)
  totalVolume     Float    @default(0)
  fuelSales       Float    @default(0)
  retailSales     Float    @default(0)
  status          String   @default("open") // open, closed, reconciled
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station    @relation(fields: [stationId], references: [id])
  fuelings    Fueling[]
  attendant   Employee?  @relation(fields: [attendantId], references: [id])
  retailTransactions RetailTransaction[]
}

// =====================================================
// FLEET & RFID
// =====================================================

model FleetAccount {
  id              String   @id @default(cuid())
  tenantId        String
  companyName     String
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  creditLimit     Float    @default(0)
  currentBalance  Float    @default(0)
  dailyLimit      Float?
  monthlyLimit    Float?
  fuelTypes       String?  // comma-separated allowed fuel types
  status          String   @default("active") // active, suspended, closed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  vehicles     Vehicle[]
  drivers      Driver[]
  fuelCards    FuelCard[]
  fuelings     Fueling[]
}

model Vehicle {
  id              String   @id @default(cuid())
  fleetAccountId  String
  plateNumber     String
  make            String?
  model           String?
  year            Int?
  vehicleType     String?  // truck, bus, car, van, tanker
  rfidTag         String?
  fuelType        String?
  tankCapacity    Float?
  dailyLimit      Float?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fleetAccount    FleetAccount @relation(fields: [fleetAccountId], references: [id])
}

model Driver {
  id              String   @id @default(cuid())
  fleetAccountId  String
  name            String
  licenseNumber   String?
  phone           String?
  rfidCard        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fleetAccount    FleetAccount @relation(fields: [fleetAccountId], references: [id])
}

model FuelCard {
  id              String   @id @default(cuid())
  tenantId        String
  cardNumber      String   @unique
  fleetAccountId  String?
  cardType        String   @default("fleet") // fleet, loyalty, prepaid
  rfidTag         String?
  pin             String?
  dailyLimit      Float?
  monthlyLimit    Float?
  balance         Float    @default(0)
  isActive        Boolean  @default(true)
  expiryDate      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  fleetAccount FleetAccount? @relation(fields: [fleetAccountId], references: [id])
}

model RFIDReader {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  code        String
  readerType  String   @default("vehicle") // vehicle, driver, card
  ipAddress   String?
  port        Int?
  status      String   @default("online") // online, offline, error
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

model ANPRCamera {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  code        String
  ipAddress   String?
  port        Int?
  location    String?
  status      String   @default("online") // online, offline, error
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// PRICE MANAGEMENT
// =====================================================

model FuelPrice {
  id          String   @id @default(cuid())
  tenantId    String
  stationId   String?
  fuelType    String
  fuelGrade   String?
  pricePerUnit Float
  previousPrice Float?
  currency    String   @default("PKR")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status      String   @default("active") // active, scheduled, expired
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PriceBoard {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  boardType   String   @default("led") // led, digital, outdoor_signage
  ipAddress   String?
  port        Int?
  status      String   @default("online") // online, offline, error
  isActive    Boolean  @default(true)
  lastUpdate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// RETAIL STORE
// =====================================================

model RetailProduct {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  sku         String?
  category    String?  // snacks, beverages, automotive, general
  barcode     String?
  price       Float
  costPrice   Float?
  stockQty    Int      @default(0)
  minStock    Int      @default(5)
  unit        String   @default("piece")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

model RetailTransaction {
  id          String   @id @default(cuid())
  stationId   String
  shiftId     String?
  totalAmount Float
  paymentMethod String @default("cash")
  items       String   // JSON string of items
  posTerminal String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  station     Station   @relation(fields: [stationId], references: [id])
  shift       Shift?    @relation(fields: [shiftId], references: [id])
}

model LubricantProduct {
  id          String   @id @default(cuid())
  stationId   String
  name        String
  brand       String?
  viscosity   String?
  category    String?  // engine_oil, transmission, hydraulic, grease, coolant
  price       Float
  costPrice   Float?
  stockQty    Int      @default(0)
  minStock    Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// EV & CNG
// =====================================================

model EVCharger {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  code            String
  connectorType   String   @default("type2") // type2, ccs, chademo, tesla
  maxPowerKw      Float    @default(50)
  status          String   @default("available") // available, charging, occupied, offline, error
  currentSession  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station      @relation(fields: [stationId], references: [id])
  sessions    ChargingSession[]
}

model ChargingSession {
  id              String   @id @default(cuid())
  chargerId       String
  stationId       String

  station         Station  @relation(fields: [stationId], references: [id])
  vehiclePlate    String?
  energyKwh       Float    @default(0)
  durationMinutes Int      @default(0)
  pricePerKwh     Float
  totalAmount     Float    @default(0)
  paymentMethod   String   @default("cash")
  status          String   @default("active") // active, completed, cancelled
  startedAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  evCharger   EVCharger @relation(fields: [chargerId], references: [id])
}

model CNGDispenser {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  code            String
  pressure        Float?
  status          String   @default("idle") // idle, dispensing, stopped, error, maintenance
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station   @relation(fields: [stationId], references: [id])
}

// =====================================================
// EMPLOYEE MANAGEMENT
// =====================================================

model Employee {
  id              String   @id @default(cuid())
  stationId       String
  name            String
  employeeId      String?
  role            String   @default("attendant") // attendant, manager, supervisor, cashier, maintenance
  phone           String?
  email           String?
  hireDate        DateTime?
  salary          Float?
  commissionRate  Float    @default(0)
  status          String   @default("active") // active, on_leave, terminated
  avatar          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  station     Station    @relation(fields: [stationId], references: [id])
  shifts      Shift[]
  fuelings    Fueling[]
  attendance  Attendance[]
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  stationId   String
  checkIn     DateTime
  checkOut    DateTime?
  status      String   @default("present") // present, absent, late, half_day
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee  @relation(fields: [employeeId], references: [id])
}

// =====================================================
// CRM & LOYALTY
// =====================================================

model Customer {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  phone           String?
  email           String?
  loyaltyPoints   Int      @default(0)
  membershipTier  String   @default("basic") // basic, silver, gold, platinum
  totalSpent      Float    @default(0)
  totalVisits     Int      @default(0)
  lastVisit       DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
}

// =====================================================
// FINANCE & ACCOUNTING
// =====================================================

model Transaction {
  id              String   @id @default(cuid())
  stationId       String
  tenantId        String

  station         Station  @relation(fields: [stationId], references: [id])
  type            String   // income, expense, transfer
  category        String   // fuel_sale, retail_sale, expense, salary, utility, delivery, other
  amount          Float
  description     String?
  referenceNumber String?
  paymentMethod   String   @default("cash") // cash, card, bank_transfer, credit
  status          String   @default("completed") // pending, completed, cancelled
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Expense {
  id              String   @id @default(cuid())
  stationId       String

  station         Station  @relation(fields: [stationId], references: [id])
  category        String   // utilities, maintenance, salary, rent, supplies, other
  amount          Float
  description     String?
  vendor          String?
  receiptNumber   String?
  date            DateTime
  approvedBy      String?
  status          String   @default("pending") // pending, approved, paid, rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =====================================================
// MAINTENANCE
// =====================================================

model MaintenanceRecord {
  id              String   @id @default(cuid())
  stationId       String
  equipmentType   String   // dispenser, nozzle, tank, atg, price_board, ev_charger, cng
  equipmentId     String
  nozzleId        String?

  station         Station  @relation(fields: [stationId], references: [id])
  type            String   // preventive, corrective, emergency, calibration
  description     String
  technician      String?
  cost            Float    @default(0)
  status          String   @default("scheduled") // scheduled, in_progress, completed, cancelled
  scheduledDate   DateTime
  completedDate   DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nozzle       Nozzle?   @relation(fields: [nozzleId], references: [id])
}

// =====================================================
// AUDIT & SECURITY
// =====================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  tenantId    String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}

// =====================================================
// AI & ANALYTICS
// =====================================================

model AIAlert {
  id          String   @id @default(cuid())
  tenantId    String
  stationId   String?

  station      Station?  @relation(fields: [stationId], references: [id])
  alertType   String   // fuel_loss, theft, leakage, meter_manipulation, variance, maintenance, demand
  severity    String   @default("warning") // info, warning, critical
  title       String
  description String?
  confidence  Float?
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIForecast {
  id          String   @id @default(cuid())
  tenantId    String
  stationId   String
  forecastType String  // demand, delivery, stock, revenue
  fuelType    String?
  predictedValue Float
  confidence  Float
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
}
